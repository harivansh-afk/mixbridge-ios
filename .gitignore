# macOS
.DS_Store
.AppleDouble
.LSOverride

# Repo-local generated / scratch
.derived-data/
DerivedData/
.tmp/
build/
index.noindex/

# Swift Package Manager / Xcode SPM checkouts
SourcePackages/
Packages/
.swiftpm/
.build/

# Xcode user-specific files
xcuserdata/
*.xcuserstate
*.xccheckout
*.xcscmblueprint
*.moved-aside
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
!default.pbxuser
!default.mode1v3
!default.mode2v3
!default.perspectivev3

# Swift compiler artifacts (usually live under build dirs, but harmless to ignore)
*.swiftdoc
*.swiftmodule
*.swiftsourceinfo

# Logs / crash reports
*.log
*.crash
*.ips

# Archives & generated artifacts
*.ipa
*.dSYM.zip
*.dSYM

# Carthage (if you ever add it)
Carthage/Build/

# CocoaPods (if you ever add it)
Pods/
# Podfile.lock is usually committed; uncomment only if you intentionally don't want it tracked.
# Podfile.lock

# Fastlane (if you ever add it)
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/

# Playgrounds
timeline.xctimeline
playground.xcworkspace

# App-specific (keep noise out of git status)
thoughts/
docs/components
docs/design
docs/ios
docs/swiftui
docs/syntax
